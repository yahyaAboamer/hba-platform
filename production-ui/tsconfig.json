{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "next/image": ["./src/shims/next-image.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
