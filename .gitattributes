# Shell scripts must keep LF endings. docker-entrypoint.sh is execed inside
# a Linux container, and a CRLF shebang fails as "no such file or directory" -
# a confusing way to lose a deploy.
*.sh text eol=lf
Dockerfile text eol=lf

# The UI/UX Pro Max skill checks its data files against sha256 hashes taken
# over LF bytes; a CRLF checkout on Windows would fail its own validation.
.claude/skills/ui-ux-pro-max/data/** text eol=lf
