# Mirrors .railwayignore. Kept in step with it deliberately: the two files
# answer the same question for two builders, and a path excluded from one and
# not the other is how a build starts behaving differently from the deploy.
.venv/
.git/
__pycache__/
*.py[cod]
tests/
docs/
frontend/node_modules/
app/web/
*.log
.env
.pytest_cache/
*.egg-info/

# Build inputs that are never build outputs.
design-preview/
ops/
scripts/
.claude/
